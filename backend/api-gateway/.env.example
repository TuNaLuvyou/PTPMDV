PORT=4000
NODE_ENV=development
SERVICE_NAME=api-gateway
# PHẢI giống hệt JWT_SECRET trong backend/identity-service/.env — nếu lệch, mọi request sẽ bị 401.
JWT_SECRET=dev_only_secret_thay_khi_deploy
COOKIE_NAME=hrm-session
CORS_ORIGIN=http://localhost:3000
IDENTITY_URL=http://localhost:4001
ORGANIZATION_URL=http://localhost:4002
WORK_URL=http://localhost:4003
PAYROLL_URL=http://localhost:4004
INTEGRATION_URL=http://localhost:4005
